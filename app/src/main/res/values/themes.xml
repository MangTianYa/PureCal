<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DotCalendar" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pixel_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.DotCalendar.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pixel_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/pixel_surface</item>
        <item name="postSplashScreenTheme">@style/Theme.DotCalendar</item>
    </style>
</resources>
